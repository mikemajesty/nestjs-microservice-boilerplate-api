{
  "name": "nestjs-boilerplate-microservice-api",
  "version": "1.1.14",
  "description": "NestJs boilerplate api",
  "author": "mike.rodrigues.lima@gmail.com",
  "private": true,
  "license": "MIT",
  "@see": "https://github.com/mikemajesty/nestjs-microservice-boilerplate-api/blob/master/guides/setup/package.md",
  "overrides": {
    "mongodb": "7.4.0",
    "multer": "2.2.0",
    "undici": "6.27.0",
    "fast-uri": "^4.1.4",
    "fastify": "^5.12.1",
    "find-my-way": "^9.6.0",
    "@opentelemetry/propagator-jaeger": "^2.9.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "npm run migration:run && tsc --noEmit && nest start --watch -b swc",
    "start:debug": "npm run migration:run && tsc --noEmit && nest start --debug --watch",
    "prettier": "prettier --write \"src/**/*.json\"",
    "lint": "eslint \"{src,test}/**/*.{ts,js}\" --fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config=test/jest.config.ts --verbose --detectOpenHandles --forceExit",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config=\"./test/jest-coverage.config.ts\" --coverage --detectOpenHandles --forceExit && npm run make-badges",
    "make-badges": "istanbul-badges-readme",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "setup": "docker-compose -f docker-compose-infra.yml down -v --remove-orphans && docker-compose -f docker-compose-infra.yml up -d",
    "docker:build": "docker build -t nestjs-api .",
    "docker:run": "docker run -p 5000:5000 --env-file .env --network host --name nestjs-api --rm nestjs-api",
    "docker:stop": "docker stop nestjs-api 2>/dev/null || true",
    "docker:start": "npm run docker:stop && npm run docker:build && npm run docker:run",
    "scaffold": "./node_modules/@mikemajesty/microservice-crud/bin/microservice-crud",
    "typeorm": "ts-node -r tsconfig-paths/register \"./node_modules/typeorm/cli.js\"",
    "migration-postgres:create": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:create ./src/infra/database/postgres/migrations/Name",
    "migration-postgres:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run --dataSource ./src/infra/database/postgres/config.ts",
    "migration-postgres:undo": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert --dataSource ./src/infra/database/postgres/config.ts",
    "migration-mongo:create": "ts-node -r tsconfig-paths/register ./src/infra/database/mongo/migrations/cli.ts migration:create",
    "migration-mongo:run": "ts-node -r tsconfig-paths/register ./src/infra/database/mongo/migrations/cli.ts migration:run",
    "migration-mongo:rollback": "ts-node -r tsconfig-paths/register ./src/infra/database/mongo/migrations/cli.ts migration:rollback",
    "migration-mongo:status": "ts-node -r tsconfig-paths/register ./src/infra/database/mongo/migrations/cli.ts migration:status",
    "migration:run": "concurrently --kill-others-on-fail \"npm run migration-postgres:run\" \"npm run migration-mongo:run\"",
    "test:load": "npx artillery run .artillery/config.yaml --record --key <token> ",
    "check-newest:deps": "npx npm-check-updates",
    "renew:deps": "concurrently \"rm -rf node_modules package-lock.json\" \"rm -rf dist\" && npm install",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@fastify/compress": "^9.2.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@mikemajesty/mongo-migration": "^0.0.12",
    "@mikemajesty/zod-mock-schema": "^1.0.35",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/event-emitter": "^12.0.0",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-mongodb": "^0.75.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/instrumentation-redis": "^0.70.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "axios": "^1.20.0",
    "axios-better-stacktrace": "^2.1.7",
    "axios-retry": "^4.5.0",
    "class-validator": "^0.15.1",
    "colorette": "^2.0.20",
    "convert-pino-request-to-curl": "^1.0.11",
    "handlebars": "^4.7.9",
    "i18next": "^26.4.2",
    "js-yaml": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mongoose": "^9.10.0",
    "mongoose-paginate-v2": "^1.9.5",
    "nestjs-convert-to-curl": "^2.0.7",
    "nestjs-i18n": "^10.8.5",
    "nestjs-otel": "^8.1.1",
    "node-cache": "^5.1.2",
    "nodemailer": "^10.0.8",
    "opossum": "^10.0.0",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "ping": "^1.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-loki": "^3.0.0",
    "pino-pretty": "^13.1.3",
    "randexp": "^0.5.3",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "systeminformation": "^5.33.10",
    "typeorm": "^1.1.1",
    "uuid": "^14.0.2",
    "validator-brasil": "^1.0.0",
    "write-excel-file": "^4.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.2",
    "zod-i18n-map": "^2.27.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@mikemajesty/microservice-crud": "7.1.12",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.1",
    "@nestjs/testing": "^12.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@testcontainers/mongodb": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/opossum": "^8.1.9",
    "@types/ping": "^0.4.4",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typespec/compiler": "^1.16.0",
    "artillery": "^2.0.34",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-you-dont-need-lodash-underscore": "^6.14.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "istanbul-badges-readme": "^1.9.0",
    "jest": "^30.5.1",
    "lint-staged": "^17.5.1",
    "npm-check-updates": "^23.1.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
